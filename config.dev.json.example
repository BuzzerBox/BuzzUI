{
  "server": {
    "address": "localhost"
  },
  "fileServer": {
    "localPath": "media"
  },
  "enableBrowserKeypressEvents": true,
  "serial": {
    "address": "/tmp/ttyV0"
  },
  "update": {
    "enabled": false
  },
  "storage": {
    "boxPath": "box-storage"
  },
  "boxSettings": {
    "file": "box-storage/buzzerbox.txt",
    "defaultsFile": "",
    "useHelper": false,
    "sshKeysFile": "box-storage/buzzerbox-ssh-keys.txt",
    "activeSshKeysFile": ""
  }
}
