# Copy to .env and fill in.

# The address Caddy serves and gets a TLS certificate for. Without a domain, use the server's
# public IPv4 address with sslip.io, e.g. 3-120-45-67.sslip.io for 3.120.45.67
SITE_ADDRESS=3-120-45-67.sslip.io

# The login everyone shares. Create the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'the password'
# and keep the single quotes, since the hash contains $ signs
BASIC_AUTH_USER=buzzer
BASIC_AUTH_HASH='$2a$14$...'
