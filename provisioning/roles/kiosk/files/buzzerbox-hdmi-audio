#!/bin/sh
# Started by buzzerbox-kiosk.service, see roles/kiosk/tasks/main.yml. At boot, WirePlumber probes the HDMI sound cards
# before cage has switched the HDMI output on, and vc4-hdmi refuses to open them then (error 524). The card then only
# has the profiles "off" and "pro-audio" and the media play into the "Dummy Output". This waits until the HDMI output
# takes sound and lets WirePlumber probe the cards again.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

has_hdmi_sink() {
    wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q 'node.name = "alsa_output\.'
}

for _ in $(seq 30); do
    if has_hdmi_sink; then
        exit 0
    fi
    # HDMI-A-1, the output that roles/base forces on; a tenth of a second of silence
    if aplay -q -D hdmi:CARD=vc4hdmi0,DEV=0 -f S16_LE -r 48000 -c 2 -s 4800 /dev/zero 2>/dev/null; then
        systemctl --user restart wireplumber.service
        exit 0
    fi
    sleep 1
done
echo "The HDMI output didn't take sound within 30 s" >&2
exit 1
