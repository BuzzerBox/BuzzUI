#!/bin/sh
# Run by buzzerbox-hdmi-audio.service, see roles/kiosk/tasks/main.yml. Whenever the TV reports in (at boot, when it is
# plugged in or switched on), WirePlumber probes the HDMI sound card at once, and vc4-hdmi refuses to open it until the
# HDMI output is switched on again (error 524). The card then only has the profiles "off" and "pro-audio" and the media
# play into the "Dummy Output". This waits until the HDMI output takes sound and lets WirePlumber probe the card again.
# The TV (seen with an LG) then still stays silent until the output is switched on again while the sound is already
# running, so it switches cage's output off and on, which keeps Chromium and its media running.
user="${BUZZERBOX_USER:?}"

as_user() {
    runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$(id -u "$user")" WAYLAND_DISPLAY=wayland-0 "$@"
}

has_hdmi_sink() {
    as_user wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q 'node.name = "alsa_output\.'
}

# HDMI-A-1, the output that roles/base forces on
is_tv_connected() {
    grep -qx connected /sys/class/drm/card*-HDMI-A-1/status
}

# until WirePlumber and cage have reacted to the TV
sleep 3
for _ in $(seq 30); do
    if has_hdmi_sink || ! is_tv_connected; then
        exit 0
    fi
    # a tenth of a second of silence
    if aplay -q -D hdmi:CARD=vc4hdmi0,DEV=0 -f S16_LE -r 48000 -c 2 -s 4800 /dev/zero 2>/dev/null; then
        as_user systemctl --user restart wireplumber.service
        for _ in $(seq 10); do
            has_hdmi_sink && break
            sleep 1
        done
        as_user wlr-randr --output HDMI-A-1 --off
        sleep 1
        as_user wlr-randr --output HDMI-A-1 --on
        exit 0
    fi
    sleep 1
done
echo "The HDMI output didn't take sound within 30 s" >&2
exit 1
