[Unit]
Description=BuzzerBox screen (Chromium kiosk in cage)
After=systemd-user-sessions.service nginx.service buzzerbox-server.service splashscreen.service getty@tty1.service
Wants=nginx.service
Conflicts=getty@tty1.service

[Service]
User={{ buzzerbox_user }}
# a logind session on tty1, which gives cage the screen and input and starts the user's PipeWire
PAMName=buzzerbox-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# the invisible cursor, see roles/kiosk/tasks/main.yml
Environment=XCURSOR_PATH=/usr/share/buzzerbox/cursors
# the splash screen holds the framebuffer until the kiosk takes over ("+": as root)
ExecStartPre=-+/usr/bin/systemctl stop splashscreen.service
# cage waits for its session on tty1 to become active, which it only is while tty1 is the console in the foreground
ExecStartPre=-+/usr/bin/chvt 1
# after a power cut, Chromium would offer to restore the last session
ExecStartPre=-/usr/bin/sed -i -e 's/"exited_cleanly":false/"exited_cleanly":true/' -e 's/"exit_type":"[^"]*"/"exit_type":"Normal"/' /home/{{ buzzerbox_user }}/.config/chromium/Default/Preferences
# the cache is in /tmp (a tmpfs), so it doesn't wear the eMMC and starts empty after every boot. 64 MB, as videos are
# cached too.
ExecStart=/usr/bin/cage -d -- /usr/bin/chromium \
  --ozone-platform=wayland \
  --kiosk --noerrdialogs --disable-infobars --no-first-run --password-store=basic \
  --autoplay-policy=no-user-gesture-required \
  --disable-restore-session-state --disk-cache-dir=/tmp/buzzerbox-kiosk-cache --disk-cache-size=67108864 \
  http://localhost/screen/
# the HDMI sound only works once cage has switched the output on, see files/buzzerbox-hdmi-audio ("+": as root)
ExecStartPost=-+/usr/bin/systemctl --no-block start buzzerbox-hdmi-audio.service
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
