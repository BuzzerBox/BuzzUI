[Unit]
Description=BuzzerBox screen and touch display (Chromium kiosk in sway)
After=systemd-user-sessions.service nginx.service buzzerbox-server.service splashscreen.service getty@tty1.service
Wants=nginx.service
Conflicts=getty@tty1.service

[Service]
User={{ buzzerbox_user }}
# a logind session on tty1, which gives sway the displays and input and starts the user's PipeWire and D-Bus
PAMName=buzzerbox-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# the invisible cursor, see roles/kiosk/tasks/main.yml
Environment=XCURSOR_PATH=/usr/share/buzzerbox/cursors
# the splash screen holds the framebuffer until the kiosk takes over ("+": as root)
ExecStartPre=-+/usr/bin/systemctl stop splashscreen.service
# sway waits for its session on tty1 to become active, which it only is while tty1 is the console in the foreground
ExecStartPre=-+/usr/bin/chvt 1
# the browsers are started by buzzerbox-kiosk-session, see sway.conf
ExecStart=/usr/bin/sway --config /etc/buzzerbox/sway.conf
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
