[Unit]
Description=BuzzerBox HDMI sound after the TV reported in
# started by the kiosk and by 99-buzzerbox-hdmi-audio.rules, see roles/kiosk/files/buzzerbox-hdmi-audio

[Service]
Type=oneshot
# as root, for runuser: WirePlumber and cage run in the kiosk user's session
Environment=BUZZERBOX_USER={{ buzzerbox_user }}
ExecStart=/usr/share/buzzerbox/buzzerbox-hdmi-audio
