# Settings of this BuzzerBox. The box reads them on every start, so change them here and restart the box.
# You can edit this file on any computer: it is on the boot partition ("bootfs") of the SD card or the eMMC.
# Lines are KEY=value without quotes. Delete a line or leave a value empty to use the default shown here.

# Name of the box's WiFi network (1-32 characters)
WIFI_SSID={{ wifi_ssid }}
# Password of the WiFi network (8-63 characters)
WIFI_PASSPHRASE={{ wifi_passphrase }}
# Country the box is used in, as a two-letter code (DE, AT, CH, GB, ...). It decides which WiFi channels are allowed.
WIFI_COUNTRY_CODE={{ wifi_country_code }}
# WiFi channel, 1-13
WIFI_CHANNEL={{ wifi_channel }}
# WiFi antenna: internal (the one on the board) or external (on the antenna connector). Only a Compute Module 4 has that
# connector, a Raspberry Pi 4 always uses its internal antenna. When this changes, the box restarts once by itself.
WIFI_ANTENNA={{ wifi_antenna }}
# Address of the box in its WiFi network. Devices get addresses .50 to .150 of the same /24 network.
SERVER_IP_ADDRESS={{ server_ip_address }}
# Address of the box on its Ethernet port (or a USB Ethernet adapter), for a notebook connected by a cable without a
# router in between. It gets an address .50 to .150 of the same /24 network, which must differ from the WiFi's.
# Don't connect the box to a network that has a router: the box would hand out addresses there too.
ETHERNET_IP_ADDRESS={{ ethernet_ip_address }}
# Names that devices on the WiFi or the cable can open the box under, separated by spaces
SERVER_HOSTNAMES={{ server_hostnames | join(' ') }}
