{
  "gameName": "Game",
  "masterName": "Master",
  "screenName": "Screen",
  "join": {
    "wifiName": "BuzzerBoxNetwork",
    "masterAddress": "buzzer.box"
  },
  "server": {
    "port": 4201,
    "address": "",
    "webSocketProtocol": "ws",
    "retryIntervalInMS": "500"
  },
  "fileServer": {
    "port": 4202,
    "localPath": "/media/pi",
    "publicPath": "/media"
  },
  "storage": {
    "boxPath": "/var/lib/buzzerbox/storage",
    "usbPath": ""
  },
  "softReleaseKey": "KeyQ",
  "softReleaseByte": 71,
  "buzzers": [
    {
      "name": "Buzzer 1",
      "key": "Digit1",
      "byte": 31
    },
    {
      "name": "Buzzer 2",
      "key": "Digit2",
      "byte": 32
    },
    {
      "name": "Buzzer 3",
      "key": "Digit3",
      "byte": 33
    },
    {
      "name": "Buzzer 4",
      "key": "Digit4",
      "byte": 34
    },
    {
      "name": "Buzzer 5",
      "key": "Digit5",
      "byte": 35
    },
    {
      "name": "Buzzer 6",
      "key": "Digit6",
      "byte": 36
    },
    {
      "name": "Buzzer 7",
      "key": "Digit7",
      "byte": 37
    },
    {
      "name": "Buzzer 8",
      "key": "Digit8",
      "byte": 38
    },
    {
      "name": "Buzzer 9",
      "key": "Digit9",
      "byte": 39
    },
    {
      "name": "Buzzer 0",
      "key": "Digit0",
      "byte": 30
    }
  ],
  "i2c": {
    "pollingInMS": "150",
    "busNumber": "1",
    "addresses": {
      "microController": "25"
    },
    "commands": {
      "softRelease": "1",
      "setBuzzer": "2"
    }
  },
  "serial": {
    "baudRate": 115200,
    "enabled": true,
    "address": "/dev/ttyS0",
    "commands": {
      "softRelease": 1,
      "setBuzzer": 2
    },
    "stuffingBit": 0,
    "eol": 255,
    "heartbeatIntervalInMS": 2000
  },
  "udpBuzzer": {
    "enabled": true,
    "listenPort": 5005,
    "heartbeatTimeoutInMS": 5000,
    "pressCollectionWindowInMS": 50,
    "batteryLowInMV": 3500,
    "provisioning": {
      "enabled": true,
      "settingsFile": "/etc/buzzerbox/wireless-buzzers.conf",
      "usbIds": ["1a86:55d4", "239a:8113", "239a:811b"],
      "wakeUsbIds": ["1a86:55d4"]
    }
  },
  "enableBrowserKeypressEvents": false,
  "reverseProxy": false,
  "update": {
    "enabled": true,
    "bundleDirectory": "",
    "command": [
      "sudo",
      "-n",
      "/usr/local/sbin/buzzerbox-update",
      "start"
    ],
    "statusFile": "/var/lib/buzzerbox/update-status.json",
    "publicKeyFile": "/etc/buzzerbox/update-public-key.pem"
  }
}
